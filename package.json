{
  "name": "homebridge-google-tv",
  "displayName": "Homebridge Google TV",
  "type": "module",
  "version": "1.1.4-beta.3",
  "description": "Homebridge plugin to add, remote control and sync playback status of google/android TVs in home app.",
  "author": {
    "name": "Vivekanand BV"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vivekanandbv"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/vivekanandbv/Homebridge-Google-TV#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekanandbv/Homebridge-Google-TV.git"
  },
  "bugs": {
    "url": "https://github.com/vivekanandbv/Homebridge-Google-TV/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "main": "dist/index.js",
  "homebridge": {
    "pluginAlias": "ADBCast",
    "pluginType": "platform"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@foxxmd/chromecast-client": "^1.0.4",
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "androidtv-remote": "^1.0.10",
    "bonjour-service": "^1.4.4",
    "castv2": "^0.1.10",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
